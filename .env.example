# Example environment variables
# FastAPI
APP_NAME=MultiAgentCodeReviewer
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# PostgreSQL connection (asyncpg)
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@db:5432/reviewer

# Redis (for RQ)
REDIS_URL=redis://redis:6379/0

# GitHub App credentials (replace with your own values)
GITHUB_APP_ID=12345
GITHUB_PRIVATE_KEY=""  # PEM formatted private key
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# LLM provider (mock, openai, anthropic, etc.)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
